  {
    "nome": "notas-lancar-na-celula",
    "tipo": "passos",
    "rota": "painel/atividades/visualizar/9",
    "perfil": "prof.laura.demo",
    "passos": [
      {
        "ir": "painel/atividades/visualizar/9"
      },
      {
        "clicar": "#tabelaLancaNotas tbody tr:first-child td:nth-child(5)"
      },
      {
        "preencher": {
          "#tabelaLancaNotas tbody tr:first-child input.vc-nota[name=\"nota\"]": "99"
        }
      },
      {
        "tecla": "Enter"
      },
      {
        "esperaSel": "#tabelaLancaNotas tbody tr:first-child .vc-sinal-erro",
        "rotulo": "nota fora da escala: o alerta no próprio campo, com o motivo (Onda 8, D-74: sem o modal, a pedido do responsável)"
      },
      {
        "aguardar": 600
      },
      {
        "clicar": "#tabelaLancaNotas tbody tr:first-child td:nth-child(5)"
      },
      {
        "preencher": {
          "#tabelaLancaNotas tbody tr:first-child input.vc-nota[name=\"nota\"]": "7.5"
        }
      },
      {
        "tecla": "Enter"
      },
      {
        "aguardar": 800
      },
      {
        "ir": "painel/atividades/visualizar/9"
      },
      {
        "guardarAttr": [
          "#tabelaLancaNotas tbody tr:first-child input.vc-nota",
          "data-id",
          "nota"
        ]
      },
      {
        "banco": [
          "SELECT nota FROM rm_disciplina_atividade_notas WHERE id = {nota}",
          "^7\\.50?$"
        ],
        "rotulo": "a nota 7,5 gravada no banco (a linha do aluno)"
      },
      {
        "confereVisivel": [
          "#tabelaLancaNotas tbody tr:first-child input.vc-nota",
          "^7,5$"
        ],
        "rotulo": "depois de recarregar, a nota 7,5 visível na linha do aluno"
      }
    ]
  },
